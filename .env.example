MONGO_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Online Judge (Phase 1) ─────────────────────────────────────────────────────
# Executor adapter: "judge0" (default in Phase 1). Change to "docker" in Phase 4.
EXECUTOR_ADAPTER=judge0

# Judge0 CE public instance (free, no key needed). Override with self-hosted URL.
JUDGE0_BASE_URL=https://ce.judge0.com

# Only required for the RapidAPI-hosted paid tier (leave blank for ce.judge0.com)
JUDGE0_API_KEY=
