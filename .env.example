PORT=3000
MONGO_URL=your_mongodb_connection_string

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# ImageKit Configuration (for avatar uploads)
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Online Judge Engine
# Executor adapter: "judge0" (default).
EXECUTOR_ADAPTER=judge0

# Judge0 CE public instance (free, no key needed). Override with self-hosted URL.
JUDGE0_BASE_URL=https://ce.judge0.com

# Only required for RapidAPI-hosted tier (leave blank for ce.judge0.com)
JUDGE0_API_KEY=
